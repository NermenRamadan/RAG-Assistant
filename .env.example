# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# --- Cloud LLM (api/) --------------------------------------------------
# This project uses Groq by default: it's free to start, needs no local
# model download, and speaks the OpenAI API format.
# Get a key at https://console.groq.com/keys
LLM_API_KEY=your_api_key_here
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Want to use OpenAI instead? Just change these three lines to, e.g.:
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# --- Backend CORS (api/) ------------------------------------------------
# Comma-separate multiple origins if needed.
ALLOWED_ORIGINS=http://localhost:8501

# --- Frontend (app/) -----------------------------------------------------
BACKEND_URL=http://localhost:8000
